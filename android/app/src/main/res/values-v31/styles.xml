<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: dark background and our own animated heart (one breath). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:colorBackground">@color/aura_background</item>
        <item name="android:windowSplashScreenBackground">@color/aura_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_animated</item>
        <item name="android:windowSplashScreenAnimationDuration">1000</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/aura_background</item>
        <item name="android:colorBackground">@color/aura_background</item>
    </style>
</resources>
