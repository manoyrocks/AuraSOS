<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ system splash: same dark background; the launcher icon is shown by default. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:colorBackground">@color/aura_background</item>
        <item name="android:windowSplashScreenBackground">@color/aura_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/aura_background</item>
        <item name="android:colorBackground">@color/aura_background</item>
    </style>
</resources>
