# Security and caching headers for hosts that read a _headers file (Netlify, Cloudflare Pages).
# Other hosts: see deploy/ for nginx, Apache, Vercel and Firebase equivalents.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'; media-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  Cache-Control: no-cache

/icons/*
  Cache-Control: public, max-age=604800

/favicon.png
  Cache-Control: public, max-age=604800
